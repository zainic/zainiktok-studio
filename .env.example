# Copy to .env, set your own strong values, and keep .env private.
PORT=3000
HOST=127.0.0.1
APP_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
# For a hosted server, use an HTTPS reverse proxy and HOST=127.0.0.1.
# Encrypts TikTok OAuth tokens; run: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=REPLACE_WITH_64_CHARACTER_HEX
# A TikTok developer app with Login Kit + approved video.publish scope is required.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Must be registered exactly in TikTok portal and use HTTPS in production.
TIKTOK_REDIRECT_URI=https://your-domain.example/auth/tiktok/callback
# Optional: local demonstration only. Never enable mock in production.
TIKTOK_MOCK=false
# Enable downloading permitted public videos via installed yt-dlp command.
ENABLE_YTDLP=false
# Max uploaded video size in MB, capped at 250 by default.
MAX_UPLOAD_MB=250
# Set to 1 when behind an HTTPS proxy so session cookies include Secure.
SECURE_COOKIES=false
